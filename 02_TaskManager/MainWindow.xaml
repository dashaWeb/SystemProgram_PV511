<Window x:Class="_02_TaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_02_TaskManager"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Click="Refresh">Refresh</Button>
            <DockPanel VerticalAlignment="Center">
                <RadioButton Padding="5" VerticalContentAlignment="Center" Click="RadioButton_Click" GroupName="group1">1</RadioButton>
                <RadioButton Padding="5" VerticalContentAlignment="Center" Click="RadioButton_Click" GroupName="group1">2</RadioButton>
                <RadioButton Padding="5" VerticalContentAlignment="Center" Click="RadioButton_Click" GroupName="group1">20</RadioButton>
                <Button Padding="10 5">Stop</Button>
                <Button Click="Kill_Process" Padding="10 5">Kill</Button>
                <Button Padding="10 5">Show Details</Button>
                <Button DockPanel.Dock="Right">Go></Button>
                <TextBox DockPanel.Dock="Right" Width="100"></TextBox>
            </DockPanel>
        </ToolBar>
        <DataGrid DockPanel.Dock="Top" x:Name="grid" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Process Name" Binding="{Binding ProcessName}" />
                <DataGridTextColumn Header="PID" Binding="{Binding Id}" />
                <DataGridTextColumn Header="Total Processor Time" Binding="{Binding TotalProcessorTime}" />
                <DataGridTextColumn Header="Priority" Binding="{Binding PriorityClass}" />
                <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime}" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock DockPanel.Dock="Bottom" Name="text"></TextBlock>
        <TextBox Name="input"></TextBox>
    </DockPanel>
</Window>
