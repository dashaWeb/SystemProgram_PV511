<Window x:Class="_06_Async_await_demo_first.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_06_Async_await_demo_first"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Click="Generate" FontSize="24" Padding="10" KeyDown="Button_KeyDown" >Generate</Button>
        </ToolBar>
        <ProgressBar DockPanel.Dock="Bottom" Height="20" IsIndeterminate="True"></ProgressBar>
        <TextBox  Width="100" Height="30" KeyDown="TextBox_KeyDown"></TextBox>
        <ListBox x:Name="list"></ListBox>
    </DockPanel>
</Window>
